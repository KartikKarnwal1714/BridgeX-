PORT=5000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/bridgex
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=15000
PG_QUERY_TIMEOUT_MS=20000
PG_IDLE_TX_TIMEOUT_MS=15000

MONGO_URI=mongodb://localhost:27017/bridgex_logs

REDIS_URL=redis://localhost:6379

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1h

BCRYPT_SALT_ROUNDS=10

CLIENT_URL=http://localhost:5173

# Set these only to isolated test databases before running tests; tests must never use `bridgex`.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bridgex_test
# MONGO_URI=mongodb://localhost:27017/bridgex_logs_test

# Request logs are deleted automatically after this many days (MongoDB TTL index)
LOG_RETENTION_DAYS=30

# ---- API gateway (Phase 3) ----
# 64 hex characters (32 bytes). REQUIRED in production; encrypts upstream credentials at rest.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# GATEWAY_ENCRYPTION_KEY=
# Limits (defaults shown)
# GATEWAY_MAX_BODY_BYTES=1048576
# GATEWAY_MAX_RESPONSE_BYTES=10485760
# GATEWAY_DEFAULT_TIMEOUT_MS=10000
# GATEWAY_MAX_TIMEOUT_MS=30000
# DEVELOPMENT ONLY: comma-separated host:port of local test upstreams allowed to bypass the private-address
# block (e.g. a mock server). The server refuses to start if this is set when NODE_ENV=production.
# GATEWAY_DEV_ALLOWED_UPSTREAMS=127.0.0.1:4010

# ---- Phase 5: reliability, protocols ----
# Shared outbound client (every call BridgeX makes to an upstream). All values are milliseconds / bytes.
# OUTBOUND_CONNECT_TIMEOUT_MS=5000
# OUTBOUND_RESPONSE_TIMEOUT_MS=10000
# OUTBOUND_TOTAL_TIMEOUT_MS=30000
# OUTBOUND_IDLE_TIMEOUT_MS=10000
# Retry with exponential backoff (delay = min(max, base * 2^(n-1)), jittered). RETRY_MAX_ATTEMPTS includes the first try.
# GATEWAY_RETRY_ENABLED=true
# RETRY_MAX_ATTEMPTS=3
# RETRY_BASE_DELAY_MS=200
# RETRY_MAX_DELAY_MS=5000
# RETRY_JITTER=equal            # none | equal | full
# RETRY_MAX_RETRY_AFTER_MS=10000
# Circuit breaker (per upstream). BREAKER_STORE=redis shares state between instances; if Redis is unreachable
# each instance falls back to its own in-memory state (NOT shared) and logs a warning.
# BREAKER_FAILURE_THRESHOLD=5
# BREAKER_OPEN_MS=30000
# BREAKER_HALF_OPEN_MAX_PROBES=1
# BREAKER_SUCCESS_THRESHOLD=2
# BREAKER_STORE=redis           # redis | memory
# GraphQL endpoint limits
# GRAPHQL_MAX_DEPTH=8
# GRAPHQL_MAX_COMPLEXITY=500
# GRAPHQL_MAX_QUERY_BYTES=20000
# BREAKER_ENABLED=true
# GRAPHQL_EXEC_TIMEOUT_MS=10000
# GRAPHQL_RATE_LIMIT_PER_MINUTE=120
# GRAPHQL_INTROSPECTION=true    # set false in production if you do not want the schema to be discoverable
# SOAP limits
# SOAP_WSDL_MAX_BYTES=1048576
# SOAP_WSDL_MAX_IMPORTS=10
# SOAP_WSDL_CACHE_TTL_MS=300000

# Oversized gateway uploads: bytes discarded (never stored) before answering 413, so the client reliably receives it.
# Above the byte cap, or if the client is too slow, the gateway answers and closes the connection.
# GATEWAY_REJECT_DRAIN_MAX_BYTES=16777216
# GATEWAY_REJECT_DRAIN_TIMEOUT_MS=5000
